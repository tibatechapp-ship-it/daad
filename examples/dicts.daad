# قواميس وفهرسة وإسناد
شخص = {"الاسم": "زينب", "العمر": 28}

اطبع(f"الاسم: {شخص['الاسم']}")
اطبع(f"العمر: {شخص['العمر']}")

# إسناد فهرس: نموّ سنة كاملة
شخص["العمر"] += 1
اطبع(f"العمر القادم: {شخص['العمر']}")

# إسناد فهرس متداخل
سجل = {"داخلي": {"قيمة": 1}}
سجل["داخلي"]["قيمة"] = 42
اطبع(f"القيمة المتداخلة: {سجل['داخلي']['قيمة']}")
