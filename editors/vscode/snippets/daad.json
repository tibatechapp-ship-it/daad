{
  "دالة (function definition)": {
    "prefix": ["دالة", "function", "def"],
    "body": [
      "دالة ${1:الاسم}(${2:المعاملات}):",
      "\t${3:مرر}"
    ],
    "description": "تعريف دالة في ضاد"
  },
  "إذا (if statement)": {
    "prefix": ["إذا", "if"],
    "body": [
      "إذا ${1:الشرط}:",
      "\t${2:مرر}"
    ],
    "description": "جملة شرطية إذا"
  },
  "إذا/وإلا (if/else)": {
    "prefix": ["وإلا", "ifelse"],
    "body": [
      "إذا ${1:الشرط}:",
      "\t${2:مرر}",
      "وإلا:",
      "\t${3:مرر}"
    ],
    "description": "شرط إذا/وإلا"
  },
  "وإلا_إذا (elif)": {
    "prefix": ["وإلا_إذا", "elif"],
    "body": [
      "وإلا_إذا ${1:الشرط}:",
      "\t${2:مرر}"
    ],
    "description": "شرط وإلا_إذا (elif)"
  },
  "لكل (for loop)": {
    "prefix": ["لكل", "for"],
    "body": [
      "لكل ${1:العنصر} في ${2:المجموعة}:",
      "\t${3:اطبع(${1:العنصر})}"
    ],
    "description": "حلقة لكل…في"
  },
  "حلقة مدى (range loop)": {
    "prefix": ["مدى", "range"],
    "body": [
      "لكل ${1:س} في مدى(${2:ن}):",
      "\t${3:اطبع(س)}"
    ],
    "description": "حلقة على مدى(ن)"
  },
  "بينما (while loop)": {
    "prefix": ["بينما", "while"],
    "body": [
      "بينما ${1:الشرط}:",
      "\t${2:مرر}"
    ],
    "description": "حلقة بينما"
  },
  "صنف (class definition)": {
    "prefix": ["صنف", "class"],
    "body": [
      "صنف ${1:الاسم}:",
      "\t${2:مرر}"
    ],
    "description": "تعريف صنف (فئة)"
  },
  "حاول/إلا/أخيراً (try/except/finally)": {
    "prefix": ["حاول", "try"],
    "body": [
      "حاول:",
      "\t${1:مرر}",
      "إلا ${2:نوع_الخطأ}:",
      "\t${3:مرر}",
      "أخيراً:",
      "\t${4:مرر}"
    ],
    "description": "معالجة استثناءات"
  },
  "اطبع (print)": {
    "prefix": ["اطبع", "print"],
    "body": "اطبع(${1:\"مرحبا بالعالم\"})",
    "description": "طباعة إلى الخرج"
  },
  "استورد (import)": {
    "prefix": ["استورد", "import"],
    "body": "استورد ${1:الوحدة}",
    "description": "استيراد وحدة"
  },
  "f-string عربية": {
    "prefix": ["fسطر", "fstring"],
    "body": "f\"${1:النص} {${2:المتغير}}\"",
    "description": "نص منسّق مع interpolation"
  }
}
